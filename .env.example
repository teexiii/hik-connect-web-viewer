# Copy to .env (gitignored). Both secrets are required; the app refuses to start without them.
# Fernet key for the encrypted credential file:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAMVIEWER_SECRET_KEY=
# Signs session cookies:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Optional (defaults shown)
# MAX_STREAMS=3
# IDLE_STOP_SECONDS=30
# DATA_DIR=data
# GO2RTC_URL=http://127.0.0.1:1984
# GO2RTC_RTSP_URL=rtsp://127.0.0.1:8554
# INTERNAL_TS_BASE=http://127.0.0.1:8081
