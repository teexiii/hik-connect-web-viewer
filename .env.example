# Copy to .env (gitignored). Never commit real values.

# --- App login (your own account for this web app, not Hik-Connect) ---
APP_USERNAME=
# Generate with: uv run python -m camviewer.hash_password   (prints scrypt$... ; keep the $ signs;
# in a compose .env file wrap the whole value in single quotes)
APP_PASSWORD_HASH=
# Signs session cookies. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Hik-Connect account the server logs in with ---
HIK_CONNECT_USER=
HIK_CONNECT_PASSWORD=

# --- Behind HTTPS (Cloudflare) keep true; set false for plain-http local runs ---
COOKIE_SECURE=true
# Proxies whose X-Forwarded-* / client IP headers are trusted (default loopback only)
# FORWARDED_ALLOW_IPS=127.0.0.1

# Optional (defaults shown)
# MAX_STREAMS=3
# IDLE_STOP_SECONDS=30
# STALL_SECONDS=2
# SESSION_ROTATE_SECONDS=150
# DATA_DIR=data
# GO2RTC_URL=http://127.0.0.1:1984
# INTERNAL_TS_BASE=http://127.0.0.1:8081

# Host port for the local compose run
# HOST_PORT=8080
